# Agentbox Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   vim .env

# --- Required: Active Preset ---
# Which agent preset to use. Options: opencode, codex, claude, openclaw, demo
# The "demo" preset requires NO API keys and is good for testing.
AGENTBOX_PRESET=opencode

# --- Required: API Keys (depends on preset) ---
# OpenCode / Claude / OpenClaw presets need an Anthropic key:
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Codex preset needs an OpenAI key:
# OPENAI_API_KEY=sk-your-key-here

# --- Optional: SSH Configuration ---
# Port on the HOST that maps to the sandbox's SSH (default: 2222)
AGENTBOX_SSH_PORT=2222

# --- Optional: Installation Directory ---
# Where agentbox is installed on the host (default: /opt/agentbox)
AGENTBOX_DIR=/opt/agentbox

# --- Auto-populated by install.sh (do not edit manually) ---
# HTTP_PROXY=http://egress-proxy:3128
# HTTPS_PROXY=http://egress-proxy:3128
