PRESET_API_VERSION=1
AGENT_ID=demo
BASE_IMAGE=ubuntu:24.04
DEFAULT_CMD=/bin/bash
DEFAULT_WORKDIR=/workspace
REQUIRED_ENV_VARS=""
START_MODE=background
START_CMD="/usr/local/bin/demo-agent"
HEALTHCHECK_CMD="test -f /workspace/.agentbox/demo/healthy"
LOG_PATH=/workspace/.agentbox/demo/server.log
ACCESS_MODE=ssh
EXPOSE_PORTS=""
