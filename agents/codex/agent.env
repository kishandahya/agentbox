PRESET_API_VERSION=1
AGENT_ID=codex
BASE_IMAGE=ubuntu:24.04
DEFAULT_CMD=/bin/bash
DEFAULT_WORKDIR=/workspace
# Default auth: ChatGPT OAuth via opencode-openai-codex-auth plugin (no API key required).
# After first boot, SSH in and run: opencode auth login
# OPENAI_API_KEY still works as fallback if set.
REQUIRED_ENV_VARS=""
START_MODE=manual
