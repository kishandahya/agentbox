PRESET_API_VERSION=1
AGENT_ID=opencode
BASE_IMAGE=ubuntu:24.04
DEFAULT_CMD=/bin/bash
DEFAULT_WORKDIR=/workspace
REQUIRED_ENV_VARS="ANTHROPIC_API_KEY"
START_MODE=background
# OpenCode server mode -- see https://opencode.ai/docs/server/
# The exact flags may vary by version. Adjust START_CMD if needed.
START_CMD="opencode server --host 127.0.0.1 --port 3000"
HEALTHCHECK_CMD="curl -sf http://127.0.0.1:3000/health"
LOG_PATH=/workspace/.agentbox/opencode/server.log
ACCESS_MODE=ssh
EXPOSE_PORTS=""
