PRESET_API_VERSION=1
AGENT_ID=opencode
BASE_IMAGE=ubuntu:24.04
DEFAULT_CMD=/bin/bash
DEFAULT_WORKDIR=/workspace
# Default auth: ChatGPT OAuth via opencode-openai-codex-auth plugin (no API key required).
# After first boot, SSH in and run: opencode auth login
# API keys (ANTHROPIC_API_KEY, OPENAI_API_KEY) still work as fallback if set.
REQUIRED_ENV_VARS=""
START_MODE=background
# OpenCode headless server mode -- see https://opencode.ai/docs/server/
# Command: opencode serve [--port <number>] [--hostname <string>]
# Default port: 4096, default hostname: 127.0.0.1
# Health endpoint: GET /global/health returns { healthy: true, version: string }
# Auth: set OPENCODE_SERVER_PASSWORD for HTTP basic auth (optional)
# NOTE: First-time setup requires interactive `opencode auth login` via SSH.
START_CMD="opencode serve --host 127.0.0.1 --port 4096"
HEALTHCHECK_CMD="curl -sf http://127.0.0.1:4096/global/health"
LOG_PATH=/workspace/.agentbox/opencode/server.log
ACCESS_MODE=ssh
EXPOSE_PORTS=""
